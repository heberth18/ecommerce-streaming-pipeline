          "rawSql": "SELECT\r\n  window_start,\r\n  MAX(CASE WHEN gateway = 'stripe' THEN failure_rate END) AS stripe,\r\n  MAX(CASE WHEN gateway = 'paypal' THEN failure_rate END) AS paypal,\r\n  MAX(CASE WHEN gateway = 'mercadopago' THEN failure_rate END) AS mercadopago\r\nFROM (\r\n  SELECT\r\n    *,\r\n    ROW_NUMBER() OVER (\r\n      PARTITION BY window_start, gateway\r\n      ORDER BY _loaded_at DESC\r\n    ) AS rn\r\n  FROM `ecommerce-data-platform-497218.ecommerce_streaming.payment_metrics_5min`\r\n  WHERE window_start >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 MINUTE)\r\n)\r\nWHERE rn = 1\r\nGROUP BY window_start\r\nORDER BY window_start ASC",
